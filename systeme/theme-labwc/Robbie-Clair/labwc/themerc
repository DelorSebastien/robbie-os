# Thème de fenêtres Robbie OS (clair) pour labwc : barre de titre en verre givré blanc,
# texte bleu nuit, mêmes boutons ronds néon que le thème sombre
border.width: 1
window.titlebar.padding.width: 8
window.titlebar.padding.height: 0

window.active.border.color: #0a12241a
window.inactive.border.color: #0a122410

window.active.title.bg.color: #f6f8fbe8
window.inactive.title.bg.color: #f6f8fbdc
window.active.label.text.color: #0a1224
window.inactive.label.text.color: #8a93a6
window.label.text.justify: center

window.button.width: 22
window.button.height: 26
window.button.spacing: 2
window.button.hover.bg.corner-radius: 0

window.active.shadow.size: 50
window.inactive.shadow.size: 30
window.active.shadow.color: #0a122450
window.inactive.shadow.color: #0a122430

menu.border.width: 1
menu.border.color: #d5dbe5
menu.items.bg.color: #f7f9fcf0
menu.items.text.color: #0a1224
menu.items.active.bg.color: #0e8fb3
menu.items.active.text.color: #ffffff
menu.items.padding.x: 12
menu.items.padding.y: 6
menu.separator.color: #d5dbe5
menu.title.bg.color: #eef2f7
menu.title.text.color: #0a1224

# Alt+Tab et indications à l'écran : panneau de verre, bord cyan, élément choisi encadré
osd.bg.color: #f6f8fbee
osd.border.color: #0e8fb366
osd.border.width: 1
osd.label.text.color: #0a1224
osd.window-switcher.width: 560
osd.window-switcher.padding: 10
osd.window-switcher.item.padding.x: 14
osd.window-switcher.item.padding.y: 8
osd.window-switcher.item.active.border.width: 2
osd.window-switcher.preview.border.width: 2
osd.window-switcher.preview.border.color: #0e8fb3,#0e8fb3,#0e8fb3

# Fenêtre glissée contre un bord : aperçu en verre cyan de la place qu'elle va prendre
snapping.overlay.edge.bg.enabled: yes
snapping.overlay.edge.border.enabled: yes
snapping.overlay.edge.bg.color: #0e8fb32e
snapping.overlay.edge.border.width: 2
snapping.overlay.edge.border.color: #0e8fb3,#0e8fb3,#0e8fb3
snapping.overlay.region.bg.enabled: yes
snapping.overlay.region.border.enabled: yes
snapping.overlay.region.bg.color: #0e8fb32e
snapping.overlay.region.border.width: 2
snapping.overlay.region.border.color: #0e8fb3,#0e8fb3,#0e8fb3

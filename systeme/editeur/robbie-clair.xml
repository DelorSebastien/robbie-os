<?xml version="1.0" encoding="UTF-8"?>
<!-- Jeu de couleurs de Robbie OS pour l'éditeur de texte (Mousepad, GtkSourceView) -->
<style-scheme id="robbie-clair" name="Robbie (clair)" version="1.0">
  <author>Robbie OS</author>
  <description>Les couleurs du terminal de Robbie OS</description>
  <style name="text" foreground="#0a1224" background="#f6f8fb"/>
  <style name="cursor" foreground="#0e8fb3"/>
  <style name="selection" background="#b8e6f3"/>
  <style name="current-line" background="#e9eef6"/>
  <style name="line-numbers" foreground="#9aa4b8" background="#f6f8fb"/>
  <style name="current-line-number" foreground="#0e8fb3" background="#e9eef6"/>
  <style name="bracket-match" background="#b8e6f3" bold="true"/>
  <style name="search-match" background="#b8e6f3"/>
  <style name="right-margin" foreground="#9aa4b8" background="#e9eef6"/>
  <style name="def:comment" foreground="#7a869e" italic="true"/>
  <style name="def:string" foreground="#1a9e5c"/>
  <style name="def:keyword" foreground="#7c3aed" bold="true"/>
  <style name="def:statement" foreground="#7c3aed"/>
  <style name="def:number" foreground="#b7791f"/>
  <style name="def:boolean" foreground="#b7791f"/>
  <style name="def:constant" foreground="#b7791f"/>
  <style name="def:type" foreground="#d6336c"/>
  <style name="def:function" foreground="#0e8fb3"/>
  <style name="def:identifier" foreground="#0a1224"/>
  <style name="def:preprocessor" foreground="#d6336c"/>
  <style name="def:error" foreground="#ff6b8b" underline="error"/>
  <style name="def:heading" foreground="#0e8fb3" bold="true"/>
  <style name="def:link-text" foreground="#0e8fb3" underline="single"/>
</style-scheme>

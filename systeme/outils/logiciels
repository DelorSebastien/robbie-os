#!/usr/bin/python3
# Logiciels de Robbie OS : paquets Debian (installer, désinstaller) et mises à jour du système.
# Lancé en root par sudo, depuis la Logithèque et l'interface de Robbie OS.
#
#   logiciels installer <paquet>       (mot de passe de l'administrateur demandé par sudo)
#   logiciels desinstaller <paquet>    (idem ; jamais un paquet dont Robbie OS a besoin)
#   logiciels verifier                 (sans mot de passe pour les administrateurs, et par un minuteur)
#   logiciels mettre-a-jour            (sans mot de passe pour les administrateurs)
#
# La progression est écrite sur la sortie (« progression <pourcentage> <texte> »).
# L'état des mises à jour est rangé dans /var/lib/robbie-os/mises-a-jour.json, lisible par tous :
# l'interface et la Logithèque le surveillent (ce qui attend, et la progression d'une installation).
import fcntl
import json
import os
import re
import subprocess
import sys
import time

ETAT = '/var/lib/robbie-os/mises-a-jour.json'
VERROU = '/run/robbie-os-logiciels.lock'
JOURNAL = '/var/log/robbie-os-logiciels.log'

# Ce dont Robbie OS a besoin pour fonctionner : jamais désinstallé depuis la Logithèque
PROTEGES = {
    'labwc', 'greetd', 'cage', 'gtklock', 'swayidle', 'thunar', 'thunar-data', 'libthunarx-3-0', 'foot',
    'plymouth', 'network-manager', 'pipewire', 'wireplumber', 'pipewire-pulse', 'flatpak', 'appstream',
    'sudo', 'systemd', 'dbus', 'polkitd', 'mousepad', 'wlr-randr', 'wtype', 'wl-clipboard', 'grim',
    'unattended-upgrades', 'python3', 'apt', 'dpkg', 'linux-image-amd64', 'firmware-linux-free'
}

APT_ENV = dict(os.environ, DEBIAN_FRONTEND='noninteractive', LANG='C.UTF-8', LC_ALL='C.UTF-8')
APT_OPTIONS = [
    '-o', 'DPkg::Lock::Timeout=600',
    '-o', 'Dpkg::Options::=--force-confdef',
    '-o', 'Dpkg::Options::=--force-confold',
    '-o', 'APT::Status-Fd=1'
]


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def log(text):
    with open(JOURNAL, 'a', encoding='utf-8') as journal:
        journal.write(text)


def valid_package(name):
    if not re.fullmatch(r'[a-z0-9][a-z0-9+.-]{0,100}', name or ''):
        fail('Nom de paquet invalide')
    return name


# ---- État partagé ----

def read_state():
    try:
        with open(ETAT, encoding='utf-8') as file:
            return json.load(file)
    except (OSError, ValueError):
        return {}


def write_state(state):
    os.makedirs(os.path.dirname(ETAT), exist_ok=True)
    temporary = ETAT + '.tmp'
    with open(temporary, 'w', encoding='utf-8') as file:
        json.dump(state, file, ensure_ascii=False)
    os.chmod(temporary, 0o644)
    os.replace(temporary, ETAT)


class Progress:
    """Progression d'une étape, ramenée à [debut, fin] de l'ensemble ; affichée sur la sortie
    et, pour les mises à jour, recopiée dans l'état (pas plus d'une fois par point)."""

    def __init__(self, state=None):
        self.state = state
        self.last = -1

    def __call__(self, percent, text):
        percent = max(0, min(100, int(percent)))
        if percent == self.last:
            return
        self.last = percent
        print(f'progression {percent} {text}', flush=True)
        if self.state is not None:
            self.state['en_cours'] = {'progression': percent, 'texte': text}
            write_state(self.state)


def run_apt(args, progress, start=0, end=100):
    """apt-get avec sa progression (téléchargement sur la première moitié, installation sur la seconde)."""
    child = subprocess.Popen(['apt-get', '-y', *APT_OPTIONS, *args], env=APT_ENV,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    span = end - start
    for line in child.stdout:
        log(line)
        parts = line.rstrip('\n').split(':', 3)
        if len(parts) < 4 or parts[0] not in ('dlstatus', 'pmstatus'):
            continue
        try:
            value = float(parts[2])
        except ValueError:
            continue
        if parts[0] == 'dlstatus':
            progress(start + span * value / 200, 'Téléchargement…')
        else:
            progress(start + span * (50 + value / 2) / 100, f'Installation de {parts[1]}…')
    return child.wait() == 0


# ---- Paquets Debian ----

def installer(package):
    valid_package(package)
    policy = subprocess.run(['apt-cache', 'policy', package], env=APT_ENV, capture_output=True, text=True).stdout
    if 'Candidate: (none)' in policy or 'Candidate:' not in policy:
        fail("Ce logiciel n'existe pas dans Debian")
    progress = Progress()
    progress(0, 'Préparation…')
    if not run_apt(['install', package], progress):
        fail("L'installation n'a pas abouti")
    progress(100, 'Installé')


def desinstaller(package):
    valid_package(package)
    simulation = subprocess.run(['apt-get', '-s', 'remove', package], env=APT_ENV, capture_output=True, text=True)
    if simulation.returncode != 0:
        fail("Ce logiciel n'est pas installé")
    removed = re.findall(r'^Remv (\S+)', simulation.stdout, re.M)
    if any(name in PROTEGES or name.startswith('robbie') for name in removed):
        fail('Robbie OS a besoin de ce logiciel')
    progress = Progress()
    progress(0, 'Préparation…')
    if not run_apt(['remove', package], progress):
        fail("La désinstallation n'a pas abouti")
    progress(100, 'Désinstallé')


# ---- Mises à jour ----

def apt_updates():
    """Paquets Debian à mettre à jour : nom, version actuelle, nouvelle, correctif de sécurité ou non."""
    output = subprocess.run(['apt-get', '-s', '-o', 'Debug::NoLocking=1', 'full-upgrade'], env=APT_ENV,
                            capture_output=True, text=True).stdout
    updates = []
    for name, current, new, origin in re.findall(r'^Inst (\S+) \[([^\]]+)\] \((\S+) ([^\[]*)', output, re.M):
        updates.append({'nom': name, 'actuelle': current, 'nouvelle': new, 'securite': '-security' in origin})
    return updates


def flatpak_updates():
    """Applis Flathub (et leurs composants) à mettre à jour."""
    try:
        output = subprocess.run(['flatpak', 'remote-ls', '--system', '--updates', '--columns=ref,name,version'],
                                capture_output=True, text=True, timeout=180).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    updates = []
    for line in output.splitlines():
        columns = line.split('\t')
        if not columns[0].startswith(('app/', 'runtime/')):
            continue
        kind, ident = columns[0].split('/')[:2]
        updates.append({
            'id': ident,
            'nom': columns[1] if len(columns) > 1 and columns[1] else ident,
            'version': columns[2] if len(columns) > 2 else '',
            'appli': kind == 'app'
        })
    return updates


def check(state, refresh=True):
    if refresh:
        subprocess.run(['apt-get', '-q', '-o', 'DPkg::Lock::Timeout=600', 'update'], env=APT_ENV,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    state['systeme'] = apt_updates()
    state['applis'] = flatpak_updates()
    state['verifie'] = int(time.time())
    state['redemarrage'] = os.path.exists('/run/reboot-required')
    write_state(state)


def verifier():
    state = read_state()
    if state.get('en_cours'):
        return
    check(state)
    print(len(state['systeme']) + len(state['applis']))


def mettre_a_jour():
    state = read_state()
    progress = Progress(state)
    progress(0, 'Préparation…')
    has_flatpak = bool(state.get('applis'))
    split = 85 if has_flatpak else 100
    ok = run_apt(['full-upgrade'], progress, 0, split)

    if has_flatpak:
        child = subprocess.Popen(['flatpak', 'update', '--system', '-y', '--noninteractive'],
                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in child.stdout:
            log(line)
            match = re.search(r'(\d{1,3})%', line)
            if match:
                progress(split + (100 - split) * int(match.group(1)) / 100, 'Mise à jour des applis…')
        ok = child.wait() == 0 and ok

    count = len(state.get('systeme', [])) + len(state.get('applis', []))
    state['en_cours'] = None
    check(state, refresh=False)
    state['dernier'] = {'date': int(time.time()), 'ok': ok, 'nombre': count}
    write_state(state)
    if not ok:
        fail("Certaines mises à jour n'ont pas pu être installées")
    print('progression 100 Terminé', flush=True)


def main():
    if os.geteuid() != 0:
        fail('À lancer avec sudo')
    args = sys.argv[1:]
    commands = {
        'installer': (installer, 1),
        'desinstaller': (desinstaller, 1),
        'verifier': (verifier, 0),
        'mettre-a-jour': (mettre_a_jour, 0)
    }
    if not args or args[0] not in commands or len(args) - 1 != commands[args[0]][1]:
        fail('Usage : logiciels installer|desinstaller <paquet> | verifier | mettre-a-jour')

    # Une seule opération à la fois (apt et flatpak ne se partagent pas)
    lock = open(VERROU, 'w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        if args[0] == 'verifier':
            return
        print('progression 0 En attente d’une autre installation…', flush=True)
        fcntl.flock(lock, fcntl.LOCK_EX)

    function, _ = commands[args[0]]
    try:
        function(*args[1:])
    except BaseException:
        # (une mise à jour interrompue ne doit pas rester « en cours » pour toujours)
        if args[0] == 'mettre-a-jour':
            state = read_state()
            state['en_cours'] = None
            write_state(state)
        raise


if __name__ == '__main__':
    main()

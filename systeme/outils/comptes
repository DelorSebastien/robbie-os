#!/bin/sh
# Gestion des comptes de Robbie OS. Lancé en root par sudo, depuis les Réglages d'un administrateur
# (son mot de passe est demandé à chaque fois). Les mots de passe arrivent sur l'entrée standard,
# jamais dans les arguments (qui seraient visibles par tous les utilisateurs).
#
#   comptes creer <identifiant> <nom complet> <rang>    (mot de passe sur l'entrée)
#   comptes rang <identifiant> <rang>                   (admin, standard ou enfant)
#   comptes nom <identifiant> <nom complet>
#   comptes motdepasse <identifiant>                    (mot de passe sur l'entrée)
#   comptes supprimer <identifiant>
#   comptes invite on|off
#   comptes enfant <identifiant>                        (règles JSON sur l'entrée)
#   comptes renommer <identifiant> <nouvel identifiant> (au prochain démarrage si le compte est ouvert)
#   comptes appliquer-renommages                        (au démarrage, avant l'écran de connexion)
#
# Et pour son propre compte, sans être administrateur (sudo sans mot de passe pour « moi »,
# le mot de passe actuel est vérifié ici, en première ligne de l'entrée) :
#   comptes moi motdepasse                              (actuel puis nouveau sur l'entrée)
#   comptes moi nom <nom complet>                       (actuel sur l'entrée)
#   comptes moi identifiant <nouvel identifiant>        (actuel sur l'entrée ; au prochain démarrage)
set -eu

ENFANTS=/etc/robbie-os/enfants
RENOMMAGES=/etc/robbie-os/renommages
CALLER="${SUDO_USER:-}"

fail() {
    echo "$1" >&2
    exit 1
}

valid_user() {
    echo "$1" | grep -Eq '^[a-z][a-z0-9_-]{1,30}$' || fail "Identifiant invalide : lettres minuscules, chiffres, - et _"
}

# Seuls les comptes de personnes (UID 1000 à 59999) peuvent être modifiés, jamais les comptes du système
human_user() {
    uid=$(id -u "$1" 2>/dev/null) || fail "Ce compte n'existe pas"
    [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || fail "Ce compte appartient au système"
}

admins_count() {
    getent group sudo | cut -d: -f4 | tr ',' '\n' | grep -c . || true
}

is_admin() {
    id -nG "$1" | tr ' ' '\n' | grep -qx sudo
}

set_role() {
    user=$1
    role=$2
    case "$role" in
        admin|standard|enfant) ;;
        *) fail "Rang inconnu : $role" ;;
    esac

    # On ne retire jamais le dernier administrateur
    if is_admin "$user" && [ "$role" != admin ] && [ "$(admins_count)" -le 1 ]; then
        fail "Il faut garder au moins un administrateur"
    fi

    gpasswd -d "$user" sudo >/dev/null 2>&1 || true
    gpasswd -d "$user" robbie-enfant >/dev/null 2>&1 || true
    case "$role" in
        admin) usermod -aG sudo "$user" ;;
        enfant) usermod -aG robbie-enfant "$user" ;;
    esac
}

# Le mot de passe actuel d'un compte (première ligne de l'entrée), vérifié comme le fait la
# connexion : par unix_chkpwd, lancé au nom de ce compte
check_current() {
    IFS= read -r current || true
    printf '%s\0' "$current" | setpriv --reuid="$1" --regid="$(id -g "$1")" --clear-groups /usr/sbin/unix_chkpwd "$1" nullok >/dev/null 2>&1         || fail "Mot de passe actuel incorrect"
}

# Nouvel identifiant libre et valable
valid_new_user() {
    valid_user "$1"
    [ "$1" = invite ] && fail "Cet identifiant est réservé"
    id "$1" >/dev/null 2>&1 && fail "Cet identifiant est déjà pris"
    getent group "$1" >/dev/null 2>&1 && fail "Cet identifiant est déjà pris"
    [ -e "/home/$1" ] && fail "Cet identifiant est déjà pris"
    return 0
}

# Renommer un compte fermé : identifiant, groupe du même nom, dossier personnel, règles d'enfant,
# et les chemins écrits dans ses réglages (favoris de l'explorateur, photos…)
rename_now() {
    old=$1
    new=$2
    usermod -l "$new" "$old"
    [ "$(id -gn "$new")" = "$old" ] && groupmod -n "$new" "$old"
    usermod -d "/home/$new" -m "$new"
    [ -f "$ENFANTS/$old.json" ] && mv "$ENFANTS/$old.json" "$ENFANTS/$new.json"
    [ -f "/var/mail/$old" ] && mv "/var/mail/$old" "/var/mail/$new"
    for file in "/home/$new/.config/gtk-3.0/bookmarks" /home/"$new"/.config/robbie-os/*.json; do
        [ -f "$file" ] && sed -i "s|/home/$old/|/home/$new/|g; s|/home/$old\"|/home/$new\"|g; s|/home/$old\$|/home/$new|" "$file"
    done
    return 0
}

# Compte ouvert (des programmes tournent à son nom) : le renommage attend le prochain démarrage
rename_or_schedule() {
    if pgrep -u "$1" >/dev/null 2>&1; then
        mkdir -p "$(dirname "$RENOMMAGES")"
        grep -v "^$1 " "$RENOMMAGES" 2>/dev/null > "$RENOMMAGES.tmp" || true
        echo "$1 $2" >> "$RENOMMAGES.tmp"
        mv "$RENOMMAGES.tmp" "$RENOMMAGES"
        echo "plus-tard"
    else
        rename_now "$1" "$2"
        echo "fait"
    fi
}

read_password() {
    IFS= read -r password || true
    [ "${#password}" -ge 4 ] || fail "Mot de passe trop court (4 caractères minimum)"
}

command=${1:-}
[ $# -gt 0 ] && shift

case "$command" in
    creer)
        [ $# -eq 3 ] || fail "Usage : creer <identifiant> <nom> <rang>"
        valid_user "$1"
        id "$1" >/dev/null 2>&1 && fail "Ce compte existe déjà"
        read_password
        useradd -m -s /bin/bash -c "$2" -G video,audio,input,render "$1"
        echo "$1:$password" | chpasswd
        set_role "$1" "$3"
        ;;

    rang)
        [ $# -eq 2 ] || fail "Usage : rang <identifiant> <rang>"
        valid_user "$1"
        human_user "$1"
        set_role "$1" "$2"
        ;;

    nom)
        [ $# -eq 2 ] || fail "Usage : nom <identifiant> <nom>"
        valid_user "$1"
        human_user "$1"
        usermod -c "$2" "$1"
        ;;

    motdepasse)
        [ $# -eq 1 ] || fail "Usage : motdepasse <identifiant>"
        valid_user "$1"
        human_user "$1"
        read_password
        echo "$1:$password" | chpasswd
        ;;

    supprimer)
        [ $# -eq 1 ] || fail "Usage : supprimer <identifiant>"
        valid_user "$1"
        human_user "$1"
        [ "$1" = "$CALLER" ] && fail "Tu ne peux pas supprimer ton propre compte"
        if is_admin "$1" && [ "$(admins_count)" -le 1 ]; then fail "Il faut garder au moins un administrateur"; fi
        pkill -KILL -u "$1" 2>/dev/null || true
        userdel -r "$1" 2>/dev/null || userdel "$1"
        rm -f "$ENFANTS/$1.json"
        ;;

    invite)
        case "${1:-}" in
            on)
                if ! id invite >/dev/null 2>&1; then
                    useradd -m -s /bin/bash -c "Invité" -G video,audio,input,render invite
                fi
                # Sans mot de passe : la session invité s'ouvre d'un clic, et elle est effacée à la fin
                passwd -d invite >/dev/null
                ;;
            off)
                if id invite >/dev/null 2>&1; then
                    pkill -KILL -u invite 2>/dev/null || true
                    userdel -r invite 2>/dev/null || userdel invite
                fi
                ;;
            *) fail "Usage : invite on|off" ;;
        esac
        ;;

    enfant)
        [ $# -eq 1 ] || fail "Usage : enfant <identifiant>"
        valid_user "$1"
        human_user "$1"
        mkdir -p "$ENFANTS"
        # Règles (applis autorisées, horaires) : lisibles par tous, modifiables seulement ici
        cat > "$ENFANTS/$1.json.tmp"
        mv "$ENFANTS/$1.json.tmp" "$ENFANTS/$1.json"
        chmod 644 "$ENFANTS/$1.json"
        ;;

    renommer)
        [ $# -eq 2 ] || fail "Usage : renommer <identifiant> <nouvel identifiant>"
        valid_user "$1"
        human_user "$1"
        [ "$1" = invite ] && fail "La session invité ne se renomme pas"
        valid_new_user "$2"
        rename_or_schedule "$1" "$2"
        ;;

    appliquer-renommages)
        [ -f "$RENOMMAGES" ] || exit 0
        while read -r old new; do
            [ -n "$old" ] && [ -n "$new" ] || continue
            id "$old" >/dev/null 2>&1 && ! id "$new" >/dev/null 2>&1 && rename_now "$old" "$new" || true
        done < "$RENOMMAGES"
        rm -f "$RENOMMAGES"
        ;;

    moi)
        [ -n "$CALLER" ] || fail "Commande réservée aux Réglages"
        human_user "$CALLER"
        [ "$CALLER" = invite ] && fail "La session invité n'a pas de compte à modifier"
        what=${1:-}
        [ $# -gt 0 ] && shift
        case "$what" in
            motdepasse)
                check_current "$CALLER"
                read_password
                echo "$CALLER:$password" | chpasswd
                ;;
            nom)
                [ $# -eq 1 ] || fail "Usage : moi nom <nom>"
                check_current "$CALLER"
                usermod -c "$1" "$CALLER"
                ;;
            identifiant)
                [ $# -eq 1 ] || fail "Usage : moi identifiant <nouvel identifiant>"
                check_current "$CALLER"
                valid_new_user "$1"
                rename_or_schedule "$CALLER" "$1"
                ;;
            *) fail "Commande inconnue" ;;
        esac
        ;;

    *)
        fail "Commande inconnue"
        ;;
esac

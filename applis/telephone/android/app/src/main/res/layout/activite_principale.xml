<?xml version="1.0" encoding="utf-8"?>
<!-- Robbie Lien : l'ordinateur relié, ce qu'il peut faire, relier un ordinateur -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/orbitron"
                android:letterSpacing="0.18"
                android:text="@string/titre"
                android:textColor="@color/texte"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- L'ordinateur relié -->
        <LinearLayout
            android:id="@+id/carte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/carte_verte"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/boite_icone"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/boite_icone_verte">

                    <ImageView
                        android:id="@+id/icone_pc"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ordinateur" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nom_pc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texte"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/point"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/point" />

                        <TextView
                            android:id="@+id/etat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/vert"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/texte_carte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="#B3E2EAF8"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/orbitron"
            android:letterSpacing="0.18"
            android:text="@string/section_droits"
            android:textColor="@color/doux"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Ce que l'ordinateur peut faire (lignes ajoutées par MainActivity) -->
        <LinearLayout
            android:id="@+id/options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/carte"
            android:orientation="vertical" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <LinearLayout
            android:id="@+id/relier"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bouton_principal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_qr"
                android:tint="@color/sur_accent" />

            <TextView
                android:id="@+id/relier_texte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sur_accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/aide_relier"
            android:textColor="@color/doux"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

# Thème de fenêtres Robbie OS pour labwc : barre de titre sombre et fine,
# translucide comme le verre du bureau, boutons ronds discrets
border.width: 1
window.titlebar.padding.width: 8
window.titlebar.padding.height: 0

window.active.border.color: #ffffff1a
window.inactive.border.color: #ffffff10

window.active.title.bg.color: #0a1224e0
window.inactive.title.bg.color: #0a1224d8
window.active.label.text.color: #eef3fb
window.inactive.label.text.color: #6f7b93
window.label.text.justify: center

window.button.width: 22
window.button.height: 26
window.button.spacing: 2
window.button.hover.bg.corner-radius: 0

window.active.shadow.size: 50
window.inactive.shadow.size: 30
window.active.shadow.color: #00000080
window.inactive.shadow.color: #00000050

menu.border.width: 1
menu.border.color: #1c2842
menu.items.bg.color: #0a1020d0
menu.items.text.color: #e6ebf3
menu.items.active.bg.color: #1e9cc4
menu.items.active.text.color: #ffffff
menu.items.padding.x: 12
menu.items.padding.y: 6
menu.separator.color: #1c2842
menu.title.bg.color: #0c1424
menu.title.text.color: #ffffff

# Alt+Tab et indications à l'écran : panneau de verre, bord cyan, élément choisi encadré
osd.bg.color: #0a1224e6
osd.border.color: #5ee7ff66
osd.border.width: 1
osd.label.text.color: #eef3fb
osd.window-switcher.width: 560
osd.window-switcher.padding: 10
osd.window-switcher.item.padding.x: 14
osd.window-switcher.item.padding.y: 8
osd.window-switcher.item.active.border.width: 2
osd.window-switcher.preview.border.width: 2
osd.window-switcher.preview.border.color: #5ee7ff,#5ee7ff,#5ee7ff

# Fenêtre glissée contre un bord : aperçu en verre cyan de la place qu'elle va prendre
snapping.overlay.edge.bg.enabled: yes
snapping.overlay.edge.border.enabled: yes
snapping.overlay.edge.bg.color: #5ee7ff2e
snapping.overlay.edge.border.width: 2
snapping.overlay.edge.border.color: #5ee7ff,#5ee7ff,#5ee7ff
snapping.overlay.region.bg.enabled: yes
snapping.overlay.region.border.enabled: yes
snapping.overlay.region.bg.color: #5ee7ff2e
snapping.overlay.region.border.width: 2
snapping.overlay.region.border.color: #5ee7ff,#5ee7ff,#5ee7ff
